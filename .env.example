# Site institucional Croniu — porta local padrão: 3001
# URL canônica do site (SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://croniu.com.br

# Destino do app de profissionais (cadastro / login)
NEXT_PUBLIC_APP_URL=https://app.croniu.com.br

# Preço exibido (centavos). Padrão R$ 29,90
NEXT_PUBLIC_PRICE_CENTS=2990

# Dias de trial grátis (sem cartão de crédito)
NEXT_PUBLIC_TRIAL_DAYS=7

# Contato de suporte (padrão: appcroniu@gmail.com se vazio)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Demonstrações estendidas de ações de escrita da IA (ainda não liberadas no produto).
# false = apenas exemplos de consulta verificados + padrão de confirmação genérico.
NEXT_PUBLIC_AI_ACTION_DEMOS=false

# Preparado para analytics — não dispara eventos sem provedor configurado
NEXT_PUBLIC_ANALYTICS_ENABLED=false
